{
  "name": "@scallop-io/sui-scallop-sdk",
  "version": "4.0.0",
  "description": "Typescript sdk for interacting with Scallop contract on SUI",
  "keywords": [
    "sui",
    "scallop labs",
    "typescript",
    "blockchain"
  ],
  "author": "team@scallop.io",
  "homepage": "https://github.com/scallop-io/sui-scallop-sdk#readme",
  "bugs": "https://github.com/scallop-io/sui-scallop-sdk/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/scallop-io/sui-scallop-sdk.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js",
      "require": "./dist/logger.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist/context.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js",
      "require": "./dist/query.cjs"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js",
      "require": "./dist/builder.cjs"
    },
    "./mappers": {
      "types": "./dist/mappers.d.ts",
      "import": "./dist/mappers.js",
      "require": "./dist/mappers.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rm -rf tsconfig.tsbuildinfo ./dist",
    "build": "pnpm run build:prod",
    "build:prod": "tsup --env.NODE_ENV production",
    "build:dev": "tsup",
    "watch:tsup": "tsup --watch",
    "watch:types": "tsc --watch",
    "watch": "pnpm run clean & pnpm run watch:types & pnpm run watch:tsup",
    "test": "pnpm test:typecheck && pnpm test:all",
    "test:typecheck": "tsc -p ./test",
    "test:unit": "vitest run test/mappers.spec.ts test/querySource.spec.ts test/scallopContext.spec.ts test/configSnapshot.spec.ts test/configSources.spec.ts test/txBlockManifest.spec.ts test/txBlockModules.spec.ts test/subpathExports.spec.ts test/strictInit.spec.ts test/utils-unit.spec.ts test/rate-limiter.spec.ts test/noConsole.spec.ts test/portfolioCalculations.spec.ts test/repositories.spec.ts test/clientServices.spec.ts test/marketService.spec.ts test/obligationService.spec.ts test/spoolReadService.spec.ts test/borrowIncentiveService.spec.ts test/lendingReadService.spec.ts test/priceService.spec.ts src/repositories/ src/datasources/",
    "test:no-console": "vitest run test/noConsole.spec.ts",
    "test:query": "vitest run test/query.spec.ts",
    "test:integration": "vitest run test/address.spec.ts test/builder.spec.ts test/constants.spec.ts test/index.spec.ts test/indexer.spec.ts test/query.spec.ts test/utils.spec.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "format:fix": "prettier --ignore-path 'dist/* docs/*' --write '**/*.{ts,json,md}'",
    "lint:fix": "eslint . --ignore-pattern dist --ext .ts --fix",
    "prepare": "husky install",
    "commit": "commit",
    "release": "standard-version -f",
    "release:major": "standard-version -r major",
    "release:minor": "standard-version -r minor",
    "release:patch": "standard-version -r patch",
    "doc": "typedoc --out docs src/index.ts"
  },
  "dependencies": {
    "@pythnetwork/pyth-sui-js": "2.2.0",
    "@scallop-io/sui-kit": "2.0.1",
    "@tanstack/query-core": "5.59.16",
    "axios": "1.13.6",
    "bignumber.js": "9.3.1",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "@mysten/sui": "^2.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "18.6.1",
    "@commitlint/config-conventional": "18.6.3",
    "@commitlint/prompt-cli": "18.6.1",
    "@mysten/bcs": "2.0.3",
    "@mysten/sui": "2.11.0",
    "@mysten/utils": "0.0.0",
    "@protobuf-ts/grpcweb-transport": "2.11.1",
    "@protobuf-ts/runtime-rpc": "2.11.1",
    "@pythnetwork/price-service-client": "1.11.0",
    "@pythnetwork/price-service-sdk": "1.9.0",
    "@types/node": "20.19.37",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/expect": "3.1.1",
    "@vitest/runner": "3.1.1",
    "@vitest/spy": "3.1.1",
    "dotenv": "16.6.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-prettier": "5.5.5",
    "graphql-config": "5.1.6",
    "husky": "8.0.3",
    "lint-staged": "15.5.2",
    "prettier": "3.8.1",
    "standard-version": "9.5.0",
    "tsconfig-paths": "4.2.0",
    "tsup": "7.3.0",
    "typedoc": "0.26.11",
    "typescript": "5.5.4",
    "valibot": "1.3.1",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  },
  "lint-staged": {
    "**/*.ts": [
      "pnpm run format:fix",
      "pnpm run lint:fix"
    ],
    "**/*.json|md": [
      "pnpm run format:fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "useTabs": false,
    "quoteProps": "as-needed",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "node": true,
      "es2022": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/eslint-recommended",
      "plugin:prettier/recommended"
    ],
    "plugins": [
      "@typescript-eslint",
      "prettier"
    ],
    "parser": "@typescript-eslint/parser",
    "rules": {
      "prettier/prettier": "warn",
      "@typescript-eslint/no-explicit-any": "off",
      "no-unused-vars": "off",
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  }
}
